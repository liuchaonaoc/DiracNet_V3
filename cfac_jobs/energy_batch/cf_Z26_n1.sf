# cFAC job: high-Z low-n  Fe 1s   (Z=26, n=1, l=0)

SetAtom('Fe', 26)

# For high-Z, tighter grid (1/26 ~ 0.04 a.u.)
SetRadialGrid(600, 1.05, 10.0, 1.0e-6)

Config('g', '1s1')

ConfigEnergy(0)
OptimizeRadial(['g'])
ConfigEnergy(1)

GetPotential('cf_Z26_n1_V.dat')
WaveFuncTable('cf_Z26_n1_PQ.dat', 1, -1)

Print('done: Z=26, n=1')